# ─── Local Development Environment ───────────────────────────────────────────
# Copy this to .env when running locally.
# Keep .env pointing to production values on the server.

PORT=5000
NODE_ENV=development

# Local MongoDB (or keep the Atlas URI if you don't run Mongo locally)
MONGODB_URI=mongodb://127.0.0.1:27017/rydo_web

# JWT — use any long random string locally
JWT_SECRET=rydo_local_dev_secret_change_in_production

# Admin registration code
ADMIN_CODE=RYDO_ADMIN_2023

# Razorpay test keys (safe to use locally)
RAZORPAY_KEY_ID=rzp_test_1DP5mmOlF5G5ag
RAZORPAY_KEY_SECRET=your_razorpay_test_secret_here

# CORS — in development mode the server allows all localhost origins automatically.
# ALLOWED_ORIGINS is only read when NODE_ENV=production.
ALLOWED_ORIGINS=http://localhost:3000
